# .gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# Virtual Environments
venv/
env/
ENV/
.venv

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (processed and outputs are generated)
data/processed/*.csv
data/processed/*.xlsx
data/external/

# Large outputs
outputs/models/*.pkl
outputs/models/*.h5
outputs/visualizations/*.png
outputs/reports/*.pdf

# Secrets
.env
config_secrets.yaml
secrets.json

# Temporary
*.tmp
*.temp
.cache/

# Logs
*.log

# Do NOT ignore notebooks - they are important
# Do NOT ignore data/raw/ - that's source data
# Do NOT ignore scripts/ - that's your code
# Do NOT ignore configs/ - that's configuration
